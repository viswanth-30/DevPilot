# Backend Environment Configuration Example

# Database Configuration
# Do not use root credentials in production
DB_URL=jdbc:postgresql://localhost:5432/devpilot_db
DB_USERNAME=your-db-username
DB_PASSWORD=your-db-password

# GitHub Configuration
# Required for fetching repository data
GITHUB_TOKEN=your-github-token

# AI Provider Configuration (OpenRouter/OpenAI compatible)
AI_API_BASE_URL=https://openrouter.ai/api/v1
AI_API_KEY=your-ai-api-key
AI_API_MODEL=openrouter/free

# CORS Configuration
# Comma-separated list of allowed origins (e.g. http://localhost:5173,https://devpilot.example.com)
CORS_ALLOWED_ORIGINS=http://localhost:5173
